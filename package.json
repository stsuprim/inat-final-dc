		"format": "biome format --write"
	},
	"dependencies": {
		"discord.js": "^14.27.0",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.3",
		"@types/pg": "^8.23.1",
		"typescript": "^7.0.2"
	}
}
