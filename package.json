{
	"name": "inat-discord",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node src/main.ts",
		"dev": "node --env-file-if-exists=.env --watch src/main.ts",
